# ===== 환경 구분 =====
# local | production
ENVIRONMENT=local

# ===== 프론트엔드 주소 (CORS 허용 / OAuth 리다이렉트) =====
FRONTEND_URL=http://localhost:5173

# ===== 데이터베이스 (PostgreSQL 16) =====
# 드라이버는 asyncpg 사용
DATABASE_URL=postgresql+asyncpg://postgres:비밀번호@localhost:5432/duroorun

# ===== Redis (캐싱 / Refresh Token / 블랙리스트 / OAuth state) =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET_KEY=여기에-랜덤-시크릿-키-생성해서-넣기
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== 쿠키 (Refresh Token httpOnly 쿠키) =====
# 로컬은 비워둠(localhost 자동). 배포 시 .duroorun.com 형태로 설정
COOKIE_DOMAIN=

# ===== 소셜 로그인 OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/auth/naver/callback

# ===== 두루누비 API (공공데이터포털) =====
DURUNUBI_API_KEY=
DURUNUBI_BASE_URL=https://apis.data.go.kr/B551011/Durunubi

# ===== 카카오맵 API =====
KAKAO_MAP_API_KEY=

# ===== Gemini API (AI 리뷰 요약) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ===== Cloudflare R2 (이미지 저장) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=duroorun
R2_PUBLIC_URL=

# ===== 완주 인증 / 이미지 정책 상수 (선택: config 기본값 사용 가능) =====
# COMPLETION_RADIUS_M=300
